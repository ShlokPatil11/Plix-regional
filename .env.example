# Service A uses GPT vision for visual text detection and Gemini for translation by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_VISION_SAMPLE_SECONDS=0.5
OPENAI_VISION_ANALYSIS_SLOWDOWN=2.0
OPENAI_VISION_MASK_PREROLL_SECONDS=0.30
OPENAI_VISION_MASK_POSTROLL_SECONDS=0.20
CAPTION_CARD_PADDING_PX=10
TRANSLATION_PROVIDER=gemini
# Service B also uses Gemini to contextually repair noisy Hinglish transcripts
# before TTS. It stops rather than falling back to unsafe fragment translation.

# Optional: use Groq for translation while retaining GPT vision for OCR.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: use Claude instead by setting TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=
OPENAI_FALLBACK_MODEL=gpt-6-luna

# Required by Service B's audio dubbing stage
ELEVENLABS_API_KEY=
SYNC_API_KEY=
HF_TOKEN=

# Optional settings
PIPELINE_DATA_DIR=/data

PIPELINE_MAX_UPLOAD_BYTES=2147483648
PIPELINE_SOURCE_LANGUAGE=auto
HF_LIPSYNC_SPACE=fffiloni/LatentSync
SYNC_MODEL=lipsync-2-pro

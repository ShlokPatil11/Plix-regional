# Service A uses Gemini for visual translation by default.
# Create a Gemini API key in Google AI Studio and set it in your deployment secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TRANSLATION_PROVIDER=gemini
# Service B also uses Gemini to contextually repair noisy Hinglish transcripts
# before TTS. It stops rather than falling back to unsafe fragment translation.

# Optional: use Groq for translation while retaining Gemini for OCR.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: use Claude instead by setting TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=
OPENAI_FALLBACK_MODEL=gpt-6-luna

# Required by Service B's audio dubbing stage
ELEVENLABS_API_KEY=
SYNC_API_KEY=
HF_TOKEN=

# Optional settings
PIPELINE_DATA_DIR=/data
PIPELINE_MAX_UPLOAD_BYTES=2147483648
PIPELINE_SOURCE_LANGUAGE=auto
HF_LIPSYNC_SPACE=fffiloni/LatentSync
SYNC_MODEL=lipsync-2-pro
